<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Canteen Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/fav.png" type="image/svg" />
    @* <link rel="stylesheet" href="~/CanteenManagement_2._0.styles.css" asp-append-version="true" /> *@
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light shadow-sm" id="mainNavbar">
            <div class="container-fluid">
                <a class="navbar-brand e-learning fw-bolder" href="#"><img src="" height="30" alt="Canteen" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Menu">Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Contact">Contact</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Register">Sign Up</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted cn-bg ">
        <div class="container text-center d-flex justify-content-around align-items-center cn-footer text-white">
            <div>
                &copy; @(DateTime.Now.Year.ToString()) - Canteen Management - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
            <strong>- - -</strong>
            <div>
                Design and developed with 💝 by <strong>Dinakrushna Mohanta</strong>
            </div>
        </div>
    </footer>
    <script>
        const navbar = document.getElementById("mainNavbar");
        window.addEventListener("scroll", function () {
            console.log("Working");
            const currentScroll = window.scrollY;
            if (currentScroll === 0) {
                navbar.classList.remove("scrolled-up");
            } else {
                navbar.classList.add("scrolled-up");
            }
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
