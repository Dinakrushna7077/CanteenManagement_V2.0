@model CanteenManagement_2._0.Models.LoginViewModel
@{
    ViewBag.Title = "Login Page";
    //Layout = null; // No layout for this page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
</head>

<body>

    <div class="container-fluid min-vh-100 d-flex align-items-center">
        <div class="row w-100">

            <!-- Left Content -->
            <div class="col-md-6 d-flex align-items-center justify-content-center">
                <div class="left-content text-dark">
                    <div>
                        <h2>Welcome to Canteen Portal</h2>

                        <p>
                            regular delicious meals, track your daily food wallet balance, and skip the queue with fast digital checkouts.
                        </p>

                        <ul class="list-unstyled">
                            <li><i class="bi bi-check-circle-fill me-2"></i> Daily attendance tracking (Breakfast, Lunch, Dinner & Extras)</li>
                            <li><i class="bi bi-check-circle-fill me-2"></i> Easy meal ON / OFF scheduling</li>
                            <li><i class="bi bi-check-circle-fill me-2"></i> Monthly mess bill & token logs</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Login Form -->
            <div class="col-md-6 d-flex align-items-center justify-content-center">
                <div class="login-card">

                    <div class="text-center mb-4">
                        <h4 class="fw-bold">College Canteen Login</h4>
                        <p class="text-muted small mb-0">Access your canteen dashboard</p>
                    </div>

                    <form method="post" id="loginForm" asp-action="login" asp-controller="Account">
                        @Html.AntiForgeryToken()
                        <div class="input-group-custom container-fluid">
                            <label class="form-label">Email ID Or User Name</label>
                            <div class="text-danger">@ViewBag.Error</div>
                            <input asp-for="UserId" type="text" placeholder="Email ID or User Name" class="form-control w-100" />
                        </div>

                        <div class="input-group-custom container-fluid">
                            <label class="form-label">Password</label>
                            <div class="text-danger">@ViewBag.PassError</div>
                            <input asp-for="Password" type="password" placeholder="Password" class="form-control w-100" />

                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary">Login</button>
                        </div>

                        <div class="text-center small">
                            <a href="#" class="text-decoration-none text-muted">Forgot password?</a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>

    <script type="text/javascript">
            $("#loginForm").submit((event)=>{
                event.preventDefault();
                if(loginFormValidation())
                {
                $.ajax({
                    url: '/canteen/login',
                    type: 'POST',
                    data: $("#loginForm").serialize(),
                    success: function (response) {
                        //console.log(response);
                        if (response.success) {
                            console.log('Login successful');
                            window.location.href = response.redirectUrl;
                        } else {
                            console.log(response.message);
                        }
                    },
                    error: function () {
                        console.log('An error occurred while processing your request.');
                    }
                });
                }
            });
                    const loginFormValidation = () => {

                const userId = $("#UserId").val().trim();
                const password = $("#Password").val();

                let isValid = true;

                if (!userId) {
            console.log("Please enter your Email ID or Mobile Number.");
            return false;
        }

        if (/^\d+$/.test(userId)) {

            if (!isMobile(userId)) {
                console.log("Please enter a valid Mobile Number.");
                isValid = false;
            }
        }
        else if (userId.includes("@@") || /[a-zA-Z]/.test(userId)) {

            if (!isMail(userId)) {
                console.log("Please enter a valid Gmail ID.");
                isValid = false;
            }
        }
        else {
            console.log("Please enter a valid Mobile Number or Gmail ID.");
            isValid = false;
        }

                if (!password) {
                    console.log("Please enter your password.");
                    isValid = false;
                }

                return isValid;
            };

            const isMail=(userId)=>{
                return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(userId);
            };


            const isMobile = (userId) => {
                 return /^[6-9]\d{9}$/.test(userId);
            };
    </script>

</body>
</html>