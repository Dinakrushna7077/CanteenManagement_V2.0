<!--Contact-->

<section class="py-5 " id="contact">

    <div class="container">

        <div class="text-center mb-5">
            <span class="badge bg-primary-subtle text-primary px-4 py-2 rounded-pill mb-3">
                Contact Us
            </span>

            <h2 class="fw-bold display-5">
                We'd Love To Hear From You
            </h2>

            <p class="text-muted col-lg-7 mx-auto">
                Have a question, suggestion, or meal-related issue?
                Send us a message and our canteen team will get back to you soon.
            </p>
        </div>

        <div class="row g-4 mb-5">

            <div class="col-md-4">

                <div class="card border-0 shadow-sm rounded-4 h-100 text-center">

                    <div class="card-body p-4">

                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3"
                             style="width:70px;height:70px;">

                            <i class="bi bi-geo-alt-fill fs-2 text-primary"></i>

                        </div>

                        <h5 class="fw-bold">
                            Location
                        </h5>

                        <p class="text-muted mb-0">
                            Campus Central Canteen<br>
                            Block A
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card border-0 shadow-sm rounded-4 h-100 text-center">

                    <div class="card-body p-4">

                        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3"
                             style="width:70px;height:70px;">

                            <i class="bi bi-clock-fill fs-2 text-success"></i>

                        </div>

                        <h5 class="fw-bold">
                            Working Hours
                        </h5>

                        <p class="text-muted mb-0">
                            Monday - Sunday<br>
                            7:00 AM - 9:30 PM
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card border-0 shadow-sm rounded-4 h-100 text-center">

                    <div class="card-body p-4">

                        <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center mb-3"
                             style="width:70px;height:70px;">

                            <i class="bi bi-envelope-fill fs-2 text-danger"></i>

                        </div>

                        <h5 class="fw-bold">
                            Email
                        </h5>

                        <p class="text-muted mb-0">
                            canteen.helpdesk@gmail.com
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <div class="row justify-content-center">

            <div class="col-lg-12">

                <div class="card border-0 shadow-lg rounded-5">

                    <div class="card-body p-5">

                        <h3 class="fw-bold text-center mb-4">
                            Send Us a Message
                        </h3>

                        <form id="queryForm">

                            <div class="row g-4">

                                <div class="col-md-6">

                                    <div class="form-floating">

                                        <input type="text"
                                               class="form-control rounded-4"
                                               id="name"
                                               name="Name"
                                               placeholder="Name">

                                        <label for="name">
                                            Full Name
                                        </label>

                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="form-floating">

                                        <input type="tel"
                                               class="form-control rounded-4"
                                               id="phone"
                                               name="Mobile"
                                               placeholder="Mobile">

                                        <label for="phone">
                                            Mobile Number
                                        </label>

                                    </div>

                                </div>

                                <div class="col-12">

                                    <div class="form-floating">

                                        <input type="email"
                                               class="form-control rounded-4"
                                               id="email"
                                               name="Gmail"
                                               placeholder="Email">

                                        <label for="email">
                                            Email Address
                                        </label>

                                    </div>

                                </div>

                                <div class="col-12">

                                    <div class="form-floating">

                                        <textarea class="form-control rounded-4"
                                                  id="message"
                                                  name="Query"
                                                  style="height:170px"
                                                  placeholder="Message"></textarea>

                                        <label for="message">
                                            Your Query / Feedback
                                        </label>

                                    </div>

                                </div>

                                <div class="col-12 text-center">

                                    <button class="btn btn-primary btn-lg px-5 rounded-pill">

                                        <i class="bi bi-send-fill me-2"></i>

                                        Send Message

                                    </button>

                                </div>

                                <div class="col-12 text-center">

                                    <small class="text-muted">
                                        We usually respond within 24 hours.
                                    </small>

                                </div>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
<script type="text/javascript">
    $("#queryForm").submit((event)=>{
        event.preventDefault();
        if(isValidForm())
        {
            $.ajax({
                url: '/Home/SubmitQuery',
                type: 'POST',
                data:$(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        console.log(response.message);
                        $("#queryForm")[0].reset();
                    } else {
                        console.log(response.message);
                    }
                },
                error: function () {
                    console.log("An unexpected error occurred. Please try again later.");
                }
            });
        }
    });

    const isValidForm = () => {
        const name = $("#name").val().trim();
        const phone = $("#phone").val().trim();
        const message = $("#message").val().trim();
        if (!name || !phone || !message) {
            console.log("Please fill in all fields.");
            return false;
        }
        // Additional validation can be added here (e.g., email format, phone number format)
        // If validation passes, you can submit the form data via AJAX or any other method
        return true;
    };
</script>